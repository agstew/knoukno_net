# ---------- Core ----------
NODE_ENV=development
PORT=4000
APP_NAME=Kno U Kno
APP_DOMAIN=knoukno.co
# Production: https://knoukno.co
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
SUPPORT_EMAIL=knoukno006@gmail.com

# ---------- MongoDB workbook snapshots ----------
MONGODB_URI=mongodb://127.0.0.1:27017/knoukno

# ---------- GoDaddy MySQL ----------
# GoDaddy cPanel/Plesk MySQL host, e.g. knoukno.co or a1b2c3.hosting.godaddy.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=knoukno
DB_PASSWORD=change-me
DB_NAME=knoukno
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ---------- Auth ----------
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=60
# 'lax' works when the API shares a site with the frontend (e.g. api.knoukno.co).
# Use 'none' only if the API lives on an unrelated domain such as *.onrender.com.
COOKIE_SAMESITE=lax

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,https://knoukno.co,https://www.knoukno.co

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
# ~800 words per generated question and example, ~400 words per frontend section
AI_QUESTION_WORDS=800
AI_LANDING_WORDS=400

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ---------- PayPal ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-me

# ---------- Email (GoDaddy / Google Workspace / SendGrid / Mailchimp SMTP) ----------
# Port 465 usually means implicit TLS (secure=true).
# Port 587 commonly uses STARTTLS (secure=false unless you explicitly set it).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=knoukno006@gmail.com
SMTP_PASSWORD=change-me
MAIL_FROM="Kno U Kno <knoukno006@gmail.com>"
MAIL_RETENTION_YEARS=2

# ---------- Admin bootstrap ----------
ADMIN_EMAIL=knoukno006@gmail.com
ADMIN_PASSWORD=change-me-immediately

# ---------- Client (Vite) ----------
# Origin of the API. GoDaddy shared hosting cannot run Node, so point this at
# wherever the Express server is hosted. Baked in at build time.
VITE_API_URL=https://api.knoukno.co
VITE_PAYPAL_CLIENT_ID=replace-me
